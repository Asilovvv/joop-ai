# Copy to .env and fill in. Never commit .env.

# Database: SQLite file by default. Postgres also works: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./joop.db

# Claude API key from https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# Model and thinking mode for customer replies
JOOP_MODEL=claude-haiku-5-5
JOOP_THINKING=disabled
# Optional: low | medium | high (empty = model default)
JOOP_EFFORT=

# Random string, at least 32 characters. Signs the admin panel login cookie.
SESSION_SECRET=
# Set to true when the panel is served over HTTPS
SECURE_COOKIES=false

# Public HTTPS address of this server, e.g. https://joop.example.kg (needed for webhooks)
PUBLIC_BASE_URL=
# Domain for the HTTPS certificate when running with docker-compose, e.g. joop.example.kg
DOMAIN=

# Meta (WhatsApp Cloud API / Instagram API) webhooks
META_VERIFY_TOKEN=
META_APP_SECRET=
# Only if your Instagram app uses a separate Instagram app secret
INSTAGRAM_APP_SECRET=
GRAPH_API_VERSION=v26.0

# Background jobs: reminders and the morning summary
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
