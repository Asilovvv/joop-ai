# Copy to .env and fill in. Never commit .env.

# Database: SQLite file by default. Postgres also works: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./joop.db

# Claude API key from https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# Model and thinking mode for customer replies
JOOP_MODEL=claude-haiku-5-5
JOOP_THINKING=disabled
# Optional: low | medium | high (empty = model default)
JOOP_EFFORT=

# Random string, at least 32 characters. Signs the admin panel login cookie.
SESSION_SECRET=
# Set to true when the panel is served over HTTPS
SECURE_COOKIES=false

# Public HTTPS address of this server, e.g. https://joop.example.kg (needed for webhooks)
PUBLIC_BASE_URL=
# Domain for the HTTPS certificate when running with docker-compose, e.g. joop.example.kg
DOMAIN=

# Meta (WhatsApp Cloud API / Instagram API) webhooks
META_VERIFY_TOKEN=
META_APP_SECRET=
# Only if your Instagram app uses a separate Instagram app secret
INSTAGRAM_APP_SECRET=
GRAPH_API_VERSION=v26.0

# Public site (landing, privacy policy). Meta verification expects the legal name to match the documents.
COMPANY_LEGAL_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_TELEGRAM=

# Background jobs: reminders and the morning summary
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Self-serve SaaS: sign-up at /signup, founder console at /owner
SIGNUP_ENABLED=true
# Live demo on the site: visitor messages a day to the real AI of demo businesses (0 = off)
SITE_DEMO_DAILY_LIMIT=300
# Alert to the founder in Telegram when the AI stops answering (balance ran out, wrong key, API down).
# Any bot of yours (from @BotFather) and your chat id with it (send it a message, then open
# https://api.telegram.org/bot<token>/getUpdates and copy message.chat.id). Empty = console banner only.
FOUNDER_BOT_TOKEN=
FOUNDER_CHAT_ID=
TRIAL_DAYS=14
# Monthly price in som. Empty or 0: sign-up still works, card payment is off until you set it
PRICE_SOM=
# Password for /owner. Empty = the console is switched off
OWNER_PASSWORD=
# Shown on the billing page for transfer / QR payments (bank, account, QR instructions)
BILLING_INSTRUCTIONS=
# Card payments through FreedomPay Kyrgyzstan (merchant account required). Test mode stays on until you set false
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_CURRENCY=KGS
FREEDOMPAY_TESTING=true

# Encryption of channel tokens in the database. Create with: python -m joop gen-key
# Keep a copy in a safe place: without it the saved tokens cannot be read
TOKEN_ENCRYPTION_KEY=
